{% sw_extends '@Storefront/storefront/element/cms-element-form/form-types/contact-form.html.twig' %}

{# Datei-Anhänge – nur wenn in der Plugin-Konfiguration „Kontaktformular“ aktiviert #}
{% block cms_form_contact_comment_textarea %}
    {{ parent() }}

    {% if config('NovaTheme.config.contactUpload') %}
        {% set novaMaxFiles = config('NovaTheme.config.contactUploadMaxFiles') ?: 5 %}
        {% set novaMaxMb = config('NovaTheme.config.contactUploadMaxMb') ?: 10 %}
        {% set novaMaxTotalMb = max(novaMaxMb, config('NovaTheme.config.contactUploadMaxTotalMb') ?: 20) %}

        <div class="form-group col-12 nova-contact-upload">
            <label class="form-label" for="{{ formPrefix }}-nova-files">
                {{ 'novaTheme.contactUpload.label'|trans|sw_sanitize }}
            </label>
            <input type="file"
                   class="form-control"
                   id="{{ formPrefix }}-nova-files"
                   name="novaFiles[]"
                   multiple
                   accept=".{{ ['jpg', 'jpeg', 'png', 'gif', 'webp', 'heic', 'heif', 'pdf', 'doc', 'docx', 'xls', 'xlsx', 'odt', 'ods', 'csv', 'txt', 'rtf', 'zip', 'stl', '3mf', 'obj', 'step', 'stp', 'iges', 'igs', 'amf', 'ply', 'wrl', 'x3d', 'dxf', 'dwg']|join(',.') }}"
                   aria-describedby="{{ formPrefix }}-nova-files-hint"
                   data-nova-max-files="{{ novaMaxFiles }}"
                   data-nova-max-mb="{{ novaMaxMb }}"
                   data-nova-max-total-mb="{{ novaMaxTotalMb }}"
                   data-nova-error-count="{{ 'novaTheme.contactUpload.errorCount'|trans({'%count%': novaMaxFiles})|e('html_attr') }}"
                   data-nova-error-size="{{ 'novaTheme.contactUpload.errorSize'|trans({'%size%': novaMaxMb})|e('html_attr') }}"
                   data-nova-error-total="{{ 'novaTheme.contactUpload.errorTotal'|trans({'%size%': novaMaxTotalMb})|e('html_attr') }}">
            <div class="form-text" id="{{ formPrefix }}-nova-files-hint">
                {{ 'novaTheme.contactUpload.hint'|trans({'%count%': novaMaxFiles, '%size%': novaMaxMb})|sw_sanitize }}
            </div>
        </div>
    {% endif %}
{% endblock %}
