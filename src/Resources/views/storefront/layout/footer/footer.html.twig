{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{# Optionale erste Spalte mit Logo und Kurztext (Plugin-Konfiguration „Footer“) #}
{% block layout_footer_navigation_hotline %}
    {% set novaAboutText = config('NovaTheme.config.footerAboutText')|trim %}
    {% if novaAboutText %}
        {% set novaFooterLogo = theme_config('nova-footer-logo') %}
        {% set novaLogo = novaFooterLogo ?: theme_config('sw-logo-desktop') %}
        {% if feature('v6.8.0.0') %}<li{% else %}<div{% endif %} class="col-md-4 footer-column nova-footer-about pb-4 pb-md-0" role="listitem">
            {% if novaLogo %}
                <a href="{{ path('frontend.home.page') }}" class="nova-footer-about-logo{% if novaFooterLogo %} is-own-logo{% endif %}">
                    <img src="{{ novaLogo|sw_encode_url }}" alt="{{ 'header.logoLink'|trans|striptags }}" loading="lazy">
                </a>
            {% endif %}
            <div class="nova-footer-about-text">{{ novaAboutText|sw_sanitize }}</div>
        {% if feature('v6.8.0.0') %}</li>{% else %}</div>{% endif %}
    {% endif %}

    {{ parent() }}
{% endblock %}

{# Copyright-Hinweis: Shopware-Standard, eigener Text oder ausgeblendet (Theme-Konfiguration „Footer“) #}
{% block layout_footer_copyright %}
    {% set novaCopyrightMode = config('NovaTheme.config.footerCopyright') ?: 'shopware' %}

    {% if novaCopyrightMode == 'custom' %}
        {% set novaCopyrightText = config('NovaTheme.config.footerCopyrightText')|trim %}
        {% if novaCopyrightText is empty %}
            {% set novaCopyrightText = 'novaTheme.footer.copyright'|trans %}
        {% endif %}
        {% set novaShopName = config('core.basicInformation.shopName') ?: context.salesChannel.translated.name %}

        <div class="footer-copyright nova-footer-copyright">
            {{ novaCopyrightText|replace({ '{year}': 'now'|date('Y'), '{shop}': novaShopName })|sw_sanitize }}
        </div>
    {% elseif novaCopyrightMode != 'hidden' %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Hinweis „Alle Preise inkl. MwSt. …“ ausblenden – für Infoseiten ohne Verkauf #}
{% block layout_footer_vat %}
    {% if not config('NovaTheme.config.footerHideVat') %}
        {{ parent() }}
    {% endif %}
{% endblock %}
