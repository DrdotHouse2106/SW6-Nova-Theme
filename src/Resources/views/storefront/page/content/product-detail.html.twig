{% sw_extends '@Storefront/storefront/page/content/product-detail.html.twig' %}

{#
 # Fahrzeugangebote (VehicleOfferSubscriber): Fahrzeugkopf über der Erlebniswelt – unabhängig vom Layout,
 # die Erlebniswelt (Galerie, Beschreibung, Formular, Slider …) folgt unverändert darunter.
 # Ohne JSON-LD-Funktion von Shopware (Standard bis 6.7) stehen die Fahrzeugdaten als JSON-LD im Fahrzeugkopf,
 # und das Produkt-Microdata am Seitenrahmen entfällt (es hätte ohne Kaufbox kein Angebot).
 #}
{% block cms_content %}
    {% if page.extensions.novaVehicle|default(null) and not feature('JSON_LD_DATA') %}
        {% set cmsPageClasses = ('cms-page ' ~ page.cmsPage.cssClass|striptags)|trim %}
        <div class="{{ cmsPageClasses }}">
            {{ block('page_content_blocks') }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block page_content_blocks %}
    {% set novaVehicle = page.extensions.novaVehicle|default(null) %}
    {% if novaVehicle %}
        {% block nova_vehicle_head_container %}
            <div class="container nova-vehicle-head-container">
                {% sw_include '@NovaTheme/storefront/nova/vehicle/head.html.twig' with { product: page.product, novaVehicle: novaVehicle } %}
                {% if not feature('JSON_LD_DATA') %}
                    {% sw_include '@NovaTheme/storefront/nova/vehicle/json-ld.html.twig' with { product: page.product, novaVehicleStatus: novaVehicle.status } %}
                {% endif %}
            </div>
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}
