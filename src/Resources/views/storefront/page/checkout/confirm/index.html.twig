{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{# Newsletter-Häkchen unter den AGB – nur wenn aktiviert und die E-Mail noch nicht angemeldet ist #}
{% block page_checkout_confirm_tos_control %}
    {{ parent() }}

    {% set novaNewsletter = page.getExtension('novaNewsletter') %}
    {% if novaNewsletter and novaNewsletter['show'] %}
        {% set novaNewsletterText = config('NovaTheme.config.newsletterCheckoutText')|trim %}

        <div class="form-check nova-newsletter-checkout">
            <input type="checkbox"
                   class="form-check-input"
                   id="novaNewsletter"
                   name="novaNewsletter"
                   value="1"
                   form="confirmOrderForm">
            <label for="novaNewsletter" class="custom-control-label">
                {{ (novaNewsletterText ?: 'novaTheme.newsletter.checkout'|trans)|sw_sanitize }}
            </label>
        </div>
    {% endif %}
{% endblock %}

{# Feld „Ihre Bestellnummer“ beim Kundenkommentar (Einstellung „Kasse“) #}
{% block page_checkout_confirm_customer_comment_control %}
    {% if config('NovaTheme.config.customerOrderNumber') %}
        <div class="nova-customer-order-number mb-3">
            <label class="form-label" for="novaCustomerOrderNumber">{{ 'novaTheme.customerOrderNumber.label'|trans|sw_sanitize }}</label>
            <input type="text" class="form-control" id="novaCustomerOrderNumber" name="novaCustomerOrderNumber" maxlength="50" autocomplete="off" form="confirmOrderForm" placeholder="{{ 'novaTheme.customerOrderNumber.placeholder'|trans|striptags }}">
        </div>
    {% endif %}
    {{ parent() }}
{% endblock %}
